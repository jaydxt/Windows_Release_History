        ],
        "partitions": [
          {
            "name": "DevicePatchLevel",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    // DataSource parameter: \"Defender\" = your tenant (Advanced Hunting API, organizational sign-in),",
                "    // \"Sample\" = built-in example devices. Query text generated from kql/DevicePatchLevel.kql.",
                "    AdvancedHuntingQuery = \"let LookbackDays = 30d;",
                "let MediumAt = 1;",
                "let HighAt = 2;",
                "let CriticalAt = 3;",
                "let Catalog = externaldata(",
                "        OSFamily:string, OSName:string, Platform:string, BuildNumber:long, Revision:long,",
                "        FullBuild:string, KB:string, UpdateType:string, PatchMonth:string, PatchMonthStart:datetime,",
                "        ReleaseDate:datetime, ReleaseRank:long, IsLatestForOS:bool,",
                "        CVECount:long, CriticalCVECount:long, ExploitedCVECount:long,",
                "        CVEsReleasedSince:long, CriticalCVEsReleasedSince:long, ExploitedCVEsReleasedSince:long,",
                "        OSLatestPatchMonth:string, OSLatestFullBuild:string, OSStillServiced:bool, MsrcDocumentId:string)",
                "    [h@\"\"https://raw.githubusercontent.com/jaydxt/Windows_Release_History/master/data/Windows_Security_Releases.csv\"\"]",
                "    with (format=\"\"csv\"\", ignoreFirstRecord=true);",
                "let CatalogWithBuild = Catalog | where isnotnull(Revision);",
                "let OSInfo = CatalogWithBuild",
                "    | extend EarliestPatchMonth = PatchMonth, EarliestRank = ReleaseRank,",
                "             EarliestCVEs = CVEsReleasedSince + CVECount,",
                "             EarliestCriticalCVEs = CriticalCVEsReleasedSince + CriticalCVECount,",
                "             EarliestExploitedCVEs = ExploitedCVEsReleasedSince + ExploitedCVECount",
                "    | summarize arg_min(Revision, EarliestPatchMonth, EarliestRank, EarliestCVEs, EarliestCriticalCVEs, EarliestExploitedCVEs),",
                "                CatalogOSName = take_any(OSName), OSStillServiced = take_any(OSStillServiced),",
                "                OSLatestPatchMonth = take_any(OSLatestPatchMonth), OSLatestFullBuild = take_any(OSLatestFullBuild)",
                "      by Platform, BuildNumber",
                "    | project-away Revision;",
                "let DeviceOS = DeviceInfo",
                "    | where Timestamp > ago(LookbackDays)",
                "    | where OSPlatform startswith \"\"Windows\"\"",
                "    | summarize arg_max(Timestamp, *) by DeviceId",
                "    | project LastSeen = Timestamp, DeviceId, DeviceName, MachineGroup, OSPlatform, OSVersionInfo,",
                "              OSArchitecture, DeviceInfoBuild = OSBuild, ExposureLevel;",
                "let TvmOS = DeviceTvmSoftwareInventory",
                "    | where SoftwareVendor == \"\"microsoft\"\" and SoftwareName matches regex @\"\"^windows_(server_)?[0-9]\"\"",
                "    | extend TvmBuild = tolong(extract(@\"\"(\\d{4,5})\\.(\\d+)$\"\", 1, SoftwareVersion)),",
                "             TvmRevision = tolong(extract(@\"\"(\\d{4,5})\\.(\\d+)$\"\", 2, SoftwareVersion))",
                "    | where isnotnull(TvmRevision)",
                "    | summarize arg_max(TvmRevision, TvmBuild, DeviceOSBuild = SoftwareVersion) by DeviceId;",
                "let Devices = DeviceOS",
                "    | join kind=leftouter TvmOS on DeviceId",
                "    | project-away DeviceId1",
                "    | extend Platform = iff(OSPlatform contains \"\"Server\"\", \"\"Server\"\", \"\"Client\"\"),",
                "             BuildNumber = coalesce(TvmBuild, tolong(DeviceInfoBuild)),",
                "             Revision = TvmRevision;",
                "let Matched = Devices",
                "    | where isnotnull(Revision)",
                "    | project DeviceId, Platform, BuildNumber, DeviceRevision = Revision",
                "    | join kind=inner (CatalogWithBuild",
                "        | project Platform, BuildNumber, Revision, OSName, PatchMonth, PatchMonthStart, KB, ReleaseRank,",
                "                  CVEsReleasedSince, CriticalCVEsReleasedSince, ExploitedCVEsReleasedSince)",
                "      on Platform, BuildNumber",
                "    | where Revision <= DeviceRevision",
                "    | summarize arg_max(Revision, OSName, PatchMonth, PatchMonthStart, KB, ReleaseRank,",
                "                        CVEsReleasedSince, CriticalCVEsReleasedSince, ExploitedCVEsReleasedSince) by DeviceId",
                "    | project-away Revision;",
                "Devices",
                "| join kind=leftouter Matched on DeviceId",
                "| join kind=leftouter OSInfo on Platform, BuildNumber",
                "| extend VersionStatus = case(",
                "        isempty(CatalogOSName), \"\"Unverified version - OS build not in Microsoft security catalog\"\",",
                "        isnull(Revision), \"\"Unverified version - build revision not reported\"\",",
                "        isnull(ReleaseRank), \"\"Older than catalog history\"\",",
                "        \"\"Verified\"\")",
                "| extend OSName = coalesce(OSName, CatalogOSName, strcat(OSPlatform, \"\" \"\", OSVersionInfo)),",
                "         PatchMonth = case(",
                "            VersionStatus == \"\"Verified\"\", PatchMonth,",
                "            VersionStatus == \"\"Older than catalog history\"\", strcat(\"\"Before \"\", EarliestPatchMonth),",
                "            \"\"Unverified version\"\"),",
                "         PatchesBehind = case(",
                "            VersionStatus == \"\"Verified\"\", ReleaseRank - 1,",
                "            VersionStatus == \"\"Older than catalog history\"\", EarliestRank,",
                "            long(null)),",
                "         CVEsMissed = iff(VersionStatus == \"\"Verified\"\", CVEsReleasedSince, iff(VersionStatus == \"\"Older than catalog history\"\", EarliestCVEs, long(null))),",
                "         CriticalCVEsMissed = iff(VersionStatus == \"\"Verified\"\", CriticalCVEsReleasedSince, iff(VersionStatus == \"\"Older than catalog history\"\", EarliestCriticalCVEs, long(null))),",
                "         ExploitedCVEsMissed = iff(VersionStatus == \"\"Verified\"\", ExploitedCVEsReleasedSince, iff(VersionStatus == \"\"Older than catalog history\"\", EarliestExploitedCVEs, long(null)))",
                "| extend PatchStatus = case(",
                "        VersionStatus startswith \"\"Unverified\"\", \"\"Unverified version\"\",",
                "        OSStillServiced == false, \"\"Unsupported OS\"\",",
                "        PatchesBehind == 0, \"\"Current\"\",",
                "        PatchesBehind == 1, \"\"1 month behind\"\",",
                "        PatchesBehind == 2, \"\"2 months behind\"\",",
                "        PatchesBehind <= 5, \"\"3-5 months behind\"\",",
                "        \"\"6+ months behind\"\")",
                "| extend PatchStatusOrder = case(PatchStatus == \"\"Current\"\", 1, PatchStatus == \"\"1 month behind\"\", 2,",
                "                                 PatchStatus == \"\"2 months behind\"\", 3, PatchStatus == \"\"3-5 months behind\"\", 4,",
                "                                 PatchStatus == \"\"6+ months behind\"\", 5, PatchStatus == \"\"Unsupported OS\"\", 6, 7),",
                "         RiskLevel = case(",
                "            VersionStatus startswith \"\"Unverified\"\", \"\"Unknown\"\",",
                "            OSStillServiced == false or PatchesBehind >= CriticalAt, \"\"Critical\"\",",
                "            PatchesBehind >= HighAt, \"\"High\"\",",
                "            PatchesBehind >= MediumAt, \"\"Medium\"\",",
                "            \"\"Low\"\")",
                "| project LastSeen, DeviceId, DeviceName, MachineGroup, ExposureLevel, OSPlatform, OSArchitecture,",
                "          OSName, DeviceOSBuild = coalesce(DeviceOSBuild, tostring(BuildNumber)), Platform, BuildNumber,",
                "          PatchMonth, PatchMonthStart, InstalledSecurityKB = KB, PatchesBehind,",
                "          CVEsMissed, CriticalCVEsMissed, ExploitedCVEsMissed,",
                "          LatestPatchMonth = OSLatestPatchMonth, LatestBuild = OSLatestFullBuild, OSStillServiced,",
                "          VersionStatus, PatchStatus, PatchStatusOrder, RiskLevel",
                "| order by PatchStatusOrder desc, PatchesBehind desc, DeviceName asc\",",
                "    FromDefender = () =>",
                "        let",
                "            Response = Json.Document(Web.Contents(\"https://api.securitycenter.microsoft.com\", [",
                "                RelativePath = \"api/advancedqueries/run\",",
                "                Headers = [#\"Content-Type\" = \"application/json\"],",
                "                Content = Json.FromValue([Query = AdvancedHuntingQuery])",
                "            ])),",
                "            Rows = Table.FromRecords(Response[Results], List.Transform(Response[Schema], each [Name]), MissingField.UseNull),",
                "            LastSeenUtc = Table.TransformColumns(Rows, {{\"LastSeen\", each if _ = null then null else DateTimeZone.RemoveZone(DateTimeZone.From(_)), type nullable datetime},",
                "                                                       {\"PatchMonthStart\", each if _ = null then null else Date.From(DateTimeZone.From(_)), type nullable date}})",
                "        in",
                "            LastSeenUtc,",
                "    FromSample = () => #table({\"LastSeen\", \"DeviceId\", \"DeviceName\", \"MachineGroup\", \"ExposureLevel\", \"OSPlatform\", \"OSArchitecture\", \"OSName\", \"DeviceOSBuild\", \"Platform\", \"BuildNumber\", \"PatchMonth\", \"PatchMonthStart\", \"InstalledSecurityKB\", \"PatchesBehind\", \"CVEsMissed\", \"CriticalCVEsMissed\", \"ExploitedCVEsMissed\", \"LatestPatchMonth\", \"LatestBuild\", \"OSStillServiced\", \"VersionStatus\", \"PatchStatus\", \"PatchStatusOrder\", \"RiskLevel\"}, {",
                "            {#datetime(2026,10,22,9,0,0), \"sample-0000\", \"SAMPLE-WS-000\", \"Sample - Finance\", \"Low\", \"Windows11\", \"x64\", \"Windows 11 Version 24H2\", \"10.0.26100.9445\", \"Client\", 26100, \"Sep-2026\", #date(2026,9,1), \"KB5124008\", 1, 1009, 25, 1, \"Oct-2026\", \"10.0.26100.9711\", true, \"Verified\", \"1 month behind\", 2, \"Medium\"},",
                "            {#datetime(2026,10,22,2,0,0), \"sample-0001\", \"SAMPLE-WS-001\", \"Sample - HR\", \"Medium\", \"Windows11\", \"x64\", \"Windows 11 Version 24H2\", \"10.0.26100.9711\", \"Client\", 26100, \"Oct-2026\", #date(2026,10,1), \"KB5127648\", 0, 0, 0, 0, \"Oct-2026\", \"10.0.26100.9711\", true, \"Verified\", \"Current\", 1, \"Low\"},",
                "            {#datetime(2026,10,21,19,0,0), \"sample-0002\", \"SAMPLE-WS-002\", \"Sample - Finance\", \"High\", \"Windows11\", \"x64\", \"Windows 11 Version 24H2\", \"10.0.26100.9445\", \"Client\", 26100, \"Sep-2026\", #date(2026,9,1), \"KB5124008\", 1, 1009, 25, 1, \"Oct-2026\", \"10.0.26100.9711\", true, \"Verified\", \"1 month behind\", 2, \"Medium\"},",
                "            {#datetime(2026,10,21,12,0,0), \"sample-0003\", \"SAMPLE-WS-003\", \"Sample - Finance\", \"Low\", \"Windows11\", \"x64\", \"Windows 11 Version 24H2\", \"10.0.26100.9711\", \"Client\", 26100, \"Oct-2026\", #date(2026,10,1), \"KB5127648\", 0, 0, 0, 0, \"Oct-2026\", \"10.0.26100.9711\", true, \"Verified\", \"Current\", 1, \"Low\"},",
                "            {#datetime(2026,10,21,5,0,0), \"sample-0004\", \"SAMPLE-WS-004\", \"Sample - Finance\", \"Medium\", \"Windows11\", \"x64\", \"Windows 11 Version 24H2\", \"10.0.26100.9445\", \"Client\", 26100, \"Sep-2026\", #date(2026,9,1), \"KB5124008\", 1, 1009, 25, 1, \"Oct-2026\", \"10.0.26100.9711\", true, \"Verified\", \"1 month behind\", 2, \"Medium\"},",
                "            {#datetime(2026,10,20,22,0,0), \"sample-0005\", \"SAMPLE-WS-005\", \"Sample - Sales\", \"High\", \"Windows11\", \"x64\", \"Windows 11 Version 24H2\", \"10.0.26100.9445\", \"Client\", 26100, \"Sep-2026\", #date(2026,9,1), \"KB5124008\", 1, 1009, 25, 1, \"Oct-2026\", \"10.0.26100.9711\", true, \"Verified\", \"1 month behind\", 2, \"Medium\"},",
                "            {#datetime(2026,10,20,15,0,0), \"sample-0006\", \"SAMPLE-WS-006\", \"Sample - Finance\", \"Low\", \"Windows11\", \"x64\", \"Windows 11 Version 24H2\", \"10.0.26100.9445\", \"Client\", 26100, \"Sep-2026\", #date(2026,9,1), \"KB5124008\", 1, 1009, 25, 1, \"Oct-2026\", \"10.0.26100.9711\", true, \"Verified\", \"1 month behind\", 2, \"Medium\"},",
                "            {#datetime(2026,10,20,8,0,0), \"sample-0007\", \"SAMPLE-WS-007\", \"Sample - Sales\", \"Medium\", \"Windows11\", \"x64\", \"Windows 11 Version 24H2\", \"10.0.26100.9711\", \"Client\", 26100, \"Oct-2026\", #date(2026,10,1), \"KB5127648\", 0, 0, 0, 0, \"Oct-2026\", \"10.0.26100.9711\", true, \"Verified\", \"Current\", 1, \"Low\"},",
                "            {#datetime(2026,10,20,1,0,0), \"sample-0008\", \"SAMPLE-WS-008\", \"Sample - Engineering\", \"High\", \"Windows11\", \"x64\", \"Windows 11 Version 24H2\", \"10.0.26100.9711\", \"Client\", 26100, \"Oct-2026\", #date(2026,10,1), \"KB5127648\", 0, 0, 0, 0, \"Oct-2026\", \"10.0.26100.9711\", true, \"Verified\", \"Current\", 1, \"Low\"},",
                "            {#datetime(2026,10,19,18,0,0), \"sample-0009\", \"SAMPLE-WS-009\", \"Sample - Engineering\", \"Low\", \"Windows11\", \"x64\", \"Windows 11 Version 24H2\", \"10.0.26100.9711\", \"Client\", 26100, \"Oct-2026\", #date(2026,10,1), \"KB5127648\", 0, 0, 0, 0, \"Oct-2026\", \"10.0.26100.9711\", true, \"Verified\", \"Current\", 1, \"Low\"},",
                "            {#datetime(2026,10,19,11,0,0), \"sample-0010\", \"SAMPLE-WS-010\", \"Sample - Finance\", \"Medium\", \"Windows11\", \"x64\", \"Windows 11 Version 24H2\", \"10.0.26100.9445\", \"Client\", 26100, \"Sep-2026\", #date(2026,9,1), \"KB5124008\", 1, 1009, 25, 1, \"Oct-2026\", \"10.0.26100.9711\", true, \"Verified\", \"1 month behind\", 2, \"Medium\"},",
                "            {#datetime(2026,10,19,4,0,0), \"sample-0011\", \"SAMPLE-WS-011\", \"Sample - Sales\", \"High\", \"Windows11\", \"x64\", \"Windows 11 Version 24H2\", \"10.0.26100.9464\", \"Client\", 26100, \"Sep-2026\", #date(2026,9,1), \"KB5124008\", 1, 1009, 25, 1, \"Oct-2026\", \"10.0.26100.9711\", true, \"Verified\", \"1 month behind\", 2, \"Medium\"},",
                "            {#datetime(2026,10,18,21,0,0), \"sample-0012\", \"SAMPLE-WS-012\", \"Sample - Engineering\", \"Low\", \"Windows11\", \"x64\", \"Windows 11 Version 24H2\", \"10.0.26100.9168\", \"Client\", 26100, \"Aug-2026\", #date(2026,8,1), \"KB5121003\", 2, 1634, 78, 2, \"Oct-2026\", \"10.0.26100.9711\", true, \"Verified\", \"2 months behind\", 3, \"High\"},",
                "            {#datetime(2026,10,18,14,0,0), \"sample-0013\", \"SAMPLE-WS-013\", \"Sample - Finance\", \"Medium\", \"Windows11\", \"x64\", \"Windows 11 Version 24H2\", \"10.0.26100.9445\", \"Client\", 26100, \"Sep-2026\", #date(2026,9,1), \"KB5124008\", 1, 1009, 25, 1, \"Oct-2026\", \"10.0.26100.9711\", true, \"Verified\", \"1 month behind\", 2, \"Medium\"},",
                "            {#datetime(2026,10,18,7,0,0), \"sample-0014\", \"SAMPLE-WS-014\", \"Sample - Finance\", \"High\", \"Windows11\", \"x64\", \"Windows 11 Version 24H2\", \"10.0.26100.9168\", \"Client\", 26100, \"Aug-2026\", #date(2026,8,1), \"KB5121003\", 2, 1634, 78, 2, \"Oct-2026\", \"10.0.26100.9711\", true, \"Verified\", \"2 months behind\", 3, \"High\"},",
                "            {#datetime(2026,10,18,0,0,0), \"sample-0015\", \"SAMPLE-WS-015\", \"Sample - Sales\", \"Low\", \"Windows11\", \"x64\", \"Windows 11 Version 24H2\", \"10.0.26100.9168\", \"Client\", 26100, \"Aug-2026\", #date(2026,8,1), \"KB5121003\", 2, 1634, 78, 2, \"Oct-2026\", \"10.0.26100.9711\", true, \"Verified\", \"2 months behind\", 3, \"High\"},",
                "            {#datetime(2026,10,17,17,0,0), \"sample-0016\", \"SAMPLE-WS-016\", \"Sample - Engineering\", \"Medium\", \"Windows11\", \"x64\", \"Windows 11 Version 24H2\", \"10.0.26100.9445\", \"Client\", 26100, \"Sep-2026\", #date(2026,9,1), \"KB5124008\", 1, 1009, 25, 1, \"Oct-2026\", \"10.0.26100.9711\", true, \"Verified\", \"1 month behind\", 2, \"Medium\"},",
                "            {#datetime(2026,10,17,10,0,0), \"sample-0017\", \"SAMPLE-WS-017\", \"Sample - Engineering\", \"High\", \"Windows11\", \"x64\", \"Windows 11 Version 24H2\", \"10.0.26100.9711\", \"Client\", 26100, \"Oct-2026\", #date(2026,10,1), \"KB5127648\", 0, 0, 0, 0, \"Oct-2026\", \"10.0.26100.9711\", true, \"Verified\", \"Current\", 1, \"Low\"},",
                "            {#datetime(2026,10,17,3,0,0), \"sample-0018\", \"SAMPLE-WS-018\", \"Sample - Finance\", \"Low\", \"Windows11\", \"x64\", \"Windows 11 Version 24H2\", \"10.0.26100.9445\", \"Client\", 26100, \"Sep-2026\", #date(2026,9,1), \"KB5124008\", 1, 1009, 25, 1, \"Oct-2026\", \"10.0.26100.9711\", true, \"Verified\", \"1 month behind\", 2, \"Medium\"},",
                "            {#datetime(2026,10,16,20,0,0), \"sample-0019\", \"SAMPLE-WS-019\", \"Sample - HR\", \"Medium\", \"Windows11\", \"x64\", \"Windows 11 Version 24H2\", \"10.0.26100.9711\", \"Client\", 26100, \"Oct-2026\", #date(2026,10,1), \"KB5127648\", 0, 0, 0, 0, \"Oct-2026\", \"10.0.26100.9711\", true, \"Verified\", \"Current\", 1, \"Low\"},",
                "            {#datetime(2026,10,16,13,0,0), \"sample-0020\", \"SAMPLE-WS-020\", \"Sample - HR\", \"High\", \"Windows11\", \"x64\", \"Windows 11 Version 24H2\", \"10.0.26100.9711\", \"Client\", 26100, \"Oct-2026\", #date(2026,10,1), \"KB5127648\", 0, 0, 0, 0, \"Oct-2026\", \"10.0.26100.9711\", true, \"Verified\", \"Current\", 1, \"Low\"},",
                "            {#datetime(2026,10,16,6,0,0), \"sample-0021\", \"SAMPLE-WS-021\", \"Sample - Finance\", \"Low\", \"Windows11\", \"x64\", \"Windows 11 Version 24H2\", \"10.0.26100.9168\", \"Client\", 26100, \"Aug-2026\", #date(2026,8,1), \"KB5121003\", 2, 1634, 78, 2, \"Oct-2026\", \"10.0.26100.9711\", true, \"Verified\", \"2 months behind\", 3, \"High\"},",
                "            {#datetime(2026,10,15,23,0,0), \"sample-0022\", \"SAMPLE-WS-022\", \"Sample - Engineering\", \"Medium\", \"Windows11\", \"x64\", \"Windows 11 Version 24H2\", \"10.0.26100.9711\", \"Client\", 26100, \"Oct-2026\", #date(2026,10,1), \"KB5127648\", 0, 0, 0, 0, \"Oct-2026\", \"10.0.26100.9711\", true, \"Verified\", \"Current\", 1, \"Low\"},",
                "            {#datetime(2026,10,15,16,0,0), \"sample-0023\", \"SAMPLE-WS-023\", \"Sample - Engineering\", \"High\", \"Windows11\", \"x64\", \"Windows 11 Version 24H2\", \"10.0.26100.9711\", \"Client\", 26100, \"Oct-2026\", #date(2026,10,1), \"KB5127648\", 0, 0, 0, 0, \"Oct-2026\", \"10.0.26100.9711\", true, \"Verified\", \"Current\", 1, \"Low\"},",
