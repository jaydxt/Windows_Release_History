                "            {#datetime(2026,10,17,1,0,0), \"sample-0104\", \"SAMPLE-SRV-104\", \"Sample - DMZ\", \"High\", \"WindowsServer2016\", \"x64\", \"Windows Server 2016\", \"10.0.14393.9512\", \"Server\", 14393, \"Sep-2026\", #date(2026,9,1), \"KB5123099\", 1, 750, 26, 1, \"Oct-2026\", \"10.0.14393.9612\", true, \"Verified\", \"1 month behind\", 2, \"Medium\"},",
                "            {#datetime(2026,10,16,18,0,0), \"sample-0105\", \"SAMPLE-SRV-105\", \"Sample - Datacenter\", \"Low\", \"WindowsServer2016\", \"x64\", \"Windows Server 2016\", \"10.0.14393.9418\", \"Server\", 14393, \"Aug-2026\", #date(2026,8,1), \"KB5120418\", 2, 1300, 74, 2, \"Oct-2026\", \"10.0.14393.9612\", true, \"Verified\", \"2 months behind\", 3, \"High\"},",
                "            {#datetime(2026,10,16,11,0,0), \"sample-0106\", \"SAMPLE-SRV-106\", \"Sample - Datacenter\", \"Medium\", \"WindowsServer2016\", \"x64\", \"Windows Server 2016\", \"10.0.14393.9512\", \"Server\", 14393, \"Sep-2026\", #date(2026,9,1), \"KB5123099\", 1, 750, 26, 1, \"Oct-2026\", \"10.0.14393.9612\", true, \"Verified\", \"1 month behind\", 2, \"Medium\"},",
                "            {#datetime(2026,10,16,4,0,0), \"sample-0107\", \"SAMPLE-SRV-107\", \"Sample - Datacenter\", \"High\", \"WindowsServer2016\", \"x64\", \"Windows Server 2016\", \"10.0.14393.9418\", \"Server\", 14393, \"Aug-2026\", #date(2026,8,1), \"KB5120418\", 2, 1300, 74, 2, \"Oct-2026\", \"10.0.14393.9612\", true, \"Verified\", \"2 months behind\", 3, \"High\"},",
                "            {#datetime(2026,10,15,21,0,0), \"sample-0108\", \"SAMPLE-SRV-108\", \"Sample - DMZ\", \"Low\", \"WindowsServer2016\", \"x64\", \"Windows Server 2016\", \"10.0.14393.9512\", \"Server\", 14393, \"Sep-2026\", #date(2026,9,1), \"KB5123099\", 1, 750, 26, 1, \"Oct-2026\", \"10.0.14393.9612\", true, \"Verified\", \"1 month behind\", 2, \"Medium\"},",
                "            {#datetime(2026,10,15,14,0,0), \"sample-0109\", \"SAMPLE-SRV-109\", \"Sample - DMZ\", \"Medium\", \"WindowsServer2012R2\", \"x64\", \"Windows Server 2012 R2\", \"6.3.9600.23398\", \"Server\", 9600, \"Sep-2026\", #date(2026,9,1), \"KB5123066\", 1, 649, 23, 1, \"Oct-2026\", \"6.3.9600.23470\", true, \"Verified\", \"1 month behind\", 2, \"Medium\"},",
                "            {#datetime(2026,10,15,7,0,0), \"sample-0110\", \"SAMPLE-SRV-110\", \"Sample - Datacenter\", \"High\", \"WindowsServer2012R2\", \"x64\", \"Windows Server 2012 R2\", \"6.3.9600.23398\", \"Server\", 9600, \"Sep-2026\", #date(2026,9,1), \"KB5123066\", 1, 649, 23, 1, \"Oct-2026\", \"6.3.9600.23470\", true, \"Verified\", \"1 month behind\", 2, \"Medium\"},",
                "            {#datetime(2026,10,15,0,0,0), \"sample-0111\", \"SAMPLE-WS-111\", \"Sample - Engineering\", \"Low\", \"Windows11\", \"x64\", \"Windows11 \", \"10.0.27950.1000\", \"Client\", 27950, \"Unverified version\", null, null, null, null, null, null, null, null, null, \"Unverified version - OS build not in Microsoft security catalog\", \"Unverified version\", 7, \"Unknown\"},",
                "            {#datetime(2026,10,14,17,0,0), \"sample-0112\", \"SAMPLE-SRV-112\", \"Sample - Engineering\", \"Medium\", \"WindowsServer2022\", \"x64\", \"WindowsServer2022 \", \"20348\", \"Server\", 20348, \"Unverified version\", null, null, null, null, null, null, null, null, null, \"Unverified version - build revision not reported\", \"Unverified version\", 7, \"Unknown\"},",
                "            {#datetime(2026,10,14,10,0,0), \"sample-0113\", \"SAMPLE-WS-113\", \"Sample - Engineering\", \"High\", \"Windows10\", \"x64\", \"Windows 10 Version 22H2\", \"10.0.19045.1288\", \"Client\", 19045, \"Before Nov-2022\", null, null, 47, 3958, 241, 70, \"Oct-2026\", \"10.0.19045.7807\", true, \"Older than catalog history\", \"6+ months behind\", 5, \"Critical\"}",
                "        }),",
                "    Source = if DataSource = \"Defender\" then FromDefender() else FromSample(),",
                "    AllColumns = Table.SelectColumns(Source, {\"LastSeen\", \"DeviceId\", \"DeviceName\", \"MachineGroup\", \"ExposureLevel\", \"OSPlatform\", \"OSArchitecture\", \"OSName\", \"DeviceOSBuild\", \"Platform\", \"BuildNumber\", \"PatchMonth\", \"PatchMonthStart\", \"InstalledSecurityKB\", \"PatchesBehind\", \"CVEsMissed\", \"CriticalCVEsMissed\", \"ExploitedCVEsMissed\", \"LatestPatchMonth\", \"LatestBuild\", \"OSStillServiced\", \"VersionStatus\", \"PatchStatus\", \"PatchStatusOrder\", \"RiskLevel\"}, MissingField.UseNull),",
                "    WithSource = Table.AddColumn(AllColumns, \"DataSource\", each DataSource, type text),",
                "    WithRiskOrder = Table.AddColumn(WithSource, \"RiskOrder\", each",
                "        if [RiskLevel] = \"Low\" then 1 else if [RiskLevel] = \"Medium\" then 2 else if [RiskLevel] = \"High\" then 3",
                "        else if [RiskLevel] = \"Critical\" then 4 else 5, Int64.Type),",
                "    Typed = Table.TransformColumnTypes(WithRiskOrder, {{\"LastSeen\", type datetime}, {\"DeviceId\", type text}, {\"DeviceName\", type text}, {\"MachineGroup\", type text}, {\"ExposureLevel\", type text}, {\"OSPlatform\", type text}, {\"OSArchitecture\", type text}, {\"OSName\", type text}, {\"DeviceOSBuild\", type text}, {\"Platform\", type text}, {\"BuildNumber\", Int64.Type}, {\"PatchMonth\", type text}, {\"PatchMonthStart\", type date}, {\"InstalledSecurityKB\", type text}, {\"PatchesBehind\", Int64.Type}, {\"CVEsMissed\", Int64.Type}, {\"CriticalCVEsMissed\", Int64.Type}, {\"ExploitedCVEsMissed\", Int64.Type}, {\"LatestPatchMonth\", type text}, {\"LatestBuild\", type text}, {\"OSStillServiced\", type logical}, {\"VersionStatus\", type text}, {\"PatchStatus\", type text}, {\"PatchStatusOrder\", Int64.Type}, {\"RiskLevel\", type text}, {\"DataSource\", type text}, {\"RiskOrder\", Int64.Type}})",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Devices",
            "expression": "DISTINCTCOUNT ( DevicePatchLevel[DeviceId] )",
            "formatString": "#,0"
          },
          {
            "name": "Devices Current",
            "expression": "CALCULATE ( [Devices], DevicePatchLevel[PatchStatus] = \"Current\" )",
            "formatString": "#,0"
          },
          {
            "name": "% Current",
            "expression": "DIVIDE ( [Devices Current], [Devices] )",
            "formatString": "0.0%"
          },
          {
            "name": "Compliance Target",
            "expression": "0.95",
            "formatString": "0%"
          },
          {
            "name": "Gauge Max",
            "expression": "1",
            "formatString": "0%"
          },
          {
            "name": "Devices Behind",
            "expression": "CALCULATE ( [Devices], DevicePatchLevel[PatchesBehind] >= 1 )",
            "formatString": "#,0"
          },
          {
            "name": "Devices 3+ Behind",
            "expression": "CALCULATE ( [Devices], DevicePatchLevel[PatchesBehind] >= 3 )",
            "formatString": "#,0"
          },
          {
            "name": "Devices Critical Risk",
            "expression": "CALCULATE ( [Devices], DevicePatchLevel[RiskLevel] = \"Critical\" )",
            "formatString": "#,0"
          },
          {
            "name": "Devices Unsupported OS",
            "expression": "CALCULATE ( [Devices], DevicePatchLevel[PatchStatus] = \"Unsupported OS\" )",
            "formatString": "#,0"
          },
          {
            "name": "Devices Unverified",
            "expression": "CALCULATE ( [Devices], DevicePatchLevel[PatchStatus] = \"Unverified version\" )",
            "formatString": "#,0"
          },
          {
            "name": "Avg Patches Behind",
            "expression": "AVERAGEX ( FILTER ( DevicePatchLevel, NOT ISBLANK ( DevicePatchLevel[PatchesBehind] ) ), DevicePatchLevel[PatchesBehind] )",
            "formatString": "0.0"
          },
          {
            "name": "Devices Missing Exploited CVEs",
            "expression": "CALCULATE ( [Devices], DevicePatchLevel[ExploitedCVEsMissed] > 0 )",
            "formatString": "#,0"
          },
          {
            "name": "CVE Exposures",
            "expression": "SUM ( DevicePatchLevel[CVEsMissed] )",
            "formatString": "#,0"
          },
          {
            "name": "Critical CVE Exposures",
            "expression": "SUM ( DevicePatchLevel[CriticalCVEsMissed] )",
            "formatString": "#,0"
          },
          {
            "name": "Exploited CVE Exposures",
            "expression": "SUM ( DevicePatchLevel[ExploitedCVEsMissed] )",
            "formatString": "#,0"
          },
          {
            "name": "% Current Clients",
            "expression": "CALCULATE ( [% Current], DevicePatchLevel[Platform] = \"Client\" )",
            "formatString": "0.0%"
          },
          {
            "name": "% Current Servers",
            "expression": "CALCULATE ( [% Current], DevicePatchLevel[Platform] = \"Server\" )",
            "formatString": "0.0%"
          },
          {
            "name": "Risk Color",
            "expression": "SWITCH ( SELECTEDVALUE ( DevicePatchLevel[RiskLevel] ), \"Critical\", \"#B42323\", \"High\", \"#C25A2E\", \"Medium\", \"#9A6A00\", \"Low\", \"#0A7F0A\", \"#6B6B67\" )"
          },
          {
            "name": "Latest Patch Month",
            "expression": "FORMAT ( MAX ( WindowsSecurityReleases[PatchMonthStart] ), \"MMM-yyyy\" )"
          },
          {
            "name": "Data Source Label",
            "expression": "\"Data: \" & SELECTEDVALUE ( DevicePatchLevel[DataSource], \"Defender\" )"
          },
          {
            "name": "Data As Of",
            "expression": "\"Devices seen up to \" & FORMAT ( MAX ( DevicePatchLevel[LastSeen] ), \"dd-MMM-yyyy HH:mm\" )"
          },
          {
            "name": "Report Subtitle",
            "expression": "[Data Source Label] & \"  |  \" & [Data As Of] & \"  |  Latest Microsoft release: \" & [Latest Patch Month]"
          }
        ]
      },
      {
        "name": "WindowsSecurityReleases",
        "columns": [
          {
            "type": "calculated",
            "name": "OS",
            "dataType": "string",
            "expression": "SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [OSName], \"Windows Server, Version \", \"Server \" ), \"Windows Server \", \"Server \" ), \"Windows \", \"Win \" ), \" Version \", \" \" )",
            "summarizeBy": "none"
          },
          {
            "name": "OSFamily",
            "dataType": "string",
            "sourceColumn": "OSFamily",
            "summarizeBy": "none"
          },
          {
            "name": "OSName",
            "dataType": "string",
            "sourceColumn": "OSName",
            "summarizeBy": "none"
          },
          {
            "name": "Platform",
            "dataType": "string",
            "sourceColumn": "Platform",
            "summarizeBy": "none"
          },
          {
            "name": "BuildNumber",
            "dataType": "int64",
            "sourceColumn": "BuildNumber",
            "summarizeBy": "none"
          },
          {
            "name": "Revision",
            "dataType": "int64",
            "sourceColumn": "Revision",
            "summarizeBy": "none"
          },
          {
            "name": "FullBuild",
            "dataType": "string",
            "sourceColumn": "FullBuild",
            "summarizeBy": "none"
          },
          {
            "name": "KB",
            "dataType": "string",
            "sourceColumn": "KB",
            "summarizeBy": "none"
          },
          {
            "name": "UpdateType",
            "dataType": "string",
            "sourceColumn": "UpdateType",
            "summarizeBy": "none"
          },
          {
            "name": "PatchMonth",
            "dataType": "string",
            "sourceColumn": "PatchMonth",
            "summarizeBy": "none",
            "sortByColumn": "PatchMonthStart"
          },
          {
            "name": "PatchMonthStart",
            "dataType": "dateTime",
            "sourceColumn": "PatchMonthStart",
            "summarizeBy": "none",
            "formatString": "dd-MMM-yyyy"
          },
          {
            "name": "ReleaseDate",
            "dataType": "dateTime",
            "sourceColumn": "ReleaseDate",
            "summarizeBy": "none",
            "formatString": "dd-MMM-yyyy"
          },
          {
            "name": "ReleaseRank",
            "dataType": "int64",
            "sourceColumn": "ReleaseRank",
            "summarizeBy": "none"
          },
          {
            "name": "IsLatestForOS",
            "dataType": "boolean",
            "sourceColumn": "IsLatestForOS",
            "summarizeBy": "none"
          },
          {
            "name": "CVECount",
            "dataType": "int64",
            "sourceColumn": "CVECount",
            "summarizeBy": "none"
          },
          {
            "name": "CriticalCVECount",
            "dataType": "int64",
            "sourceColumn": "CriticalCVECount",
            "summarizeBy": "none"
          },
          {
            "name": "ExploitedCVECount",
            "dataType": "int64",
            "sourceColumn": "ExploitedCVECount",
            "summarizeBy": "none"
          },
          {
            "name": "CVEsReleasedSince",
            "dataType": "int64",
            "sourceColumn": "CVEsReleasedSince",
            "summarizeBy": "none"
          },
          {
            "name": "CriticalCVEsReleasedSince",
            "dataType": "int64",
            "sourceColumn": "CriticalCVEsReleasedSince",
            "summarizeBy": "none"
          },
          {
            "name": "ExploitedCVEsReleasedSince",
            "dataType": "int64",
            "sourceColumn": "ExploitedCVEsReleasedSince",
            "summarizeBy": "none"
          },
          {
            "name": "OSLatestPatchMonth",
            "dataType": "string",
            "sourceColumn": "OSLatestPatchMonth",
            "summarizeBy": "none"
          },
          {
            "name": "OSLatestFullBuild",
            "dataType": "string",
            "sourceColumn": "OSLatestFullBuild",
            "summarizeBy": "none"
          },
          {
            "name": "OSStillServiced",
            "dataType": "boolean",
            "sourceColumn": "OSStillServiced",
            "summarizeBy": "none"
          },
          {
            "name": "MsrcDocumentId",
            "dataType": "string",
            "sourceColumn": "MsrcDocumentId",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "WindowsSecurityReleases",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    // Public catalog maintained by GitHub Actions (anonymous access).",
                "    Source = Csv.Document(",
                "        Web.Contents(\"https://raw.githubusercontent.com\", [RelativePath = \"jaydxt/Windows_Release_History/master/data/Windows_Security_Releases.csv\"]),",
                "        [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"OSFamily\", type text}, {\"OSName\", type text}, {\"Platform\", type text}, {\"BuildNumber\", Int64.Type}, {\"Revision\", Int64.Type}, {\"FullBuild\", type text}, {\"KB\", type text}, {\"UpdateType\", type text}, {\"PatchMonth\", type text}, {\"PatchMonthStart\", type date}, {\"ReleaseDate\", type date}, {\"ReleaseRank\", Int64.Type}, {\"IsLatestForOS\", type logical}, {\"CVECount\", Int64.Type}, {\"CriticalCVECount\", Int64.Type}, {\"ExploitedCVECount\", Int64.Type}, {\"CVEsReleasedSince\", Int64.Type}, {\"CriticalCVEsReleasedSince\", Int64.Type}, {\"ExploitedCVEsReleasedSince\", Int64.Type}, {\"OSLatestPatchMonth\", type text}, {\"OSLatestFullBuild\", type text}, {\"OSStillServiced\", type logical}, {\"MsrcDocumentId\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Windows Versions Tracked",
            "expression": "DISTINCTCOUNT ( WindowsSecurityReleases[OSName] )",
            "formatString": "#,0"
          },
          {
            "name": "Windows Versions Serviced",
            "expression": "CALCULATE ( DISTINCTCOUNT ( WindowsSecurityReleases[OSName] ), WindowsSecurityReleases[OSStillServiced] = TRUE () )",
            "formatString": "#,0"
          },
          {
            "name": "Releases Tracked",
            "expression": "COUNTROWS ( WindowsSecurityReleases )",
            "formatString": "#,0"
          },
          {
            "name": "CVEs Fixed",
            "expression": "MAX ( WindowsSecurityReleases[CVECount] )",
            "formatString": "#,0"
          },
          {
            "name": "Latest Release CVEs",
            "expression": "VAR m = MAX ( WindowsSecurityReleases[PatchMonthStart] ) RETURN CALCULATE ( MAX ( WindowsSecurityReleases[CVECount] ), WindowsSecurityReleases[PatchMonthStart] = m )",
            "formatString": "#,0"
          },
          {
            "name": "Latest Release Exploited",
            "expression": "VAR m = MAX ( WindowsSecurityReleases[PatchMonthStart] ) RETURN CALCULATE ( MAX ( WindowsSecurityReleases[ExploitedCVECount] ), WindowsSecurityReleases[PatchMonthStart] = m )",
            "formatString": "#,0"
          },
          {
            "name": "Serviced Label",
            "expression": "IF ( SELECTEDVALUE ( WindowsSecurityReleases[OSStillServiced] ), \"Serviced\", \"End of support\" )"
          }
        ]
      }
    ],
    "expressions": [
      {
        "name": "DataSource",
        "kind": "m",
        "expression": "\"Sample\" meta [IsParameterQuery=true, List={\"Defender\", \"Sample\"}, DefaultValue=\"Defender\", Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"DataSource\", \"DevicePatchLevel\", \"WindowsSecurityReleases\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ]
  }
}
