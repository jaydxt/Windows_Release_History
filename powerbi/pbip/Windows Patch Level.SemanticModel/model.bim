          {
            "type": "calculated",
            "name": "OS",
            "dataType": "string",
            "expression": "SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [OSName], \"Windows Server, Version \", \"Server \" ), \"Windows Server \", \"Server \" ), \"Windows \", \"Win \" ), \" Version \", \" \" )",
            "summarizeBy": "none"
          },
          {
            "name": "LastSeen",
            "dataType": "dateTime",
            "sourceColumn": "LastSeen",
            "summarizeBy": "none",
            "formatString": "dd-MMM-yyyy HH:mm"
          },
